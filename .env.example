# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (PostgreSQL / Supabase)
# For local Docker: jdbc:postgresql://postgres:5432/pathwise
# For Supabase Cloud: jdbc:postgresql://<HOST>:5432/postgres?sslmode=require
DB_URL=jdbc:postgresql://localhost:5432/pathwise
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pathwise
DB_USERNAME=pathwise
DB_PASSWORD=CHANGE_ME

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Docker PostgreSQL
POSTGRES_USER=pathwise
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=pathwise
