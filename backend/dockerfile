FROM maven:3.9-eclipse-temurin-21
# Stage 1: Build the application with Maven
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /app

# Copy pom.xml and download dependencies first for efficient caching
COPY pom.xml .
RUN mvn dependency:go-offline -B

RUN mvn dependency:go-offline
# Copy application source code and package
COPY src ./src
RUN mvn clean package -DskipTests -B

COPY . .
# Stage 2: Production runtime image
FROM eclipse-temurin:21-jre-alpine AS runner

WORKDIR /app

# Run as non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup
RUN mkdir -p /app/uploads /tmp/uploads/handbooks && chown -R appuser:appgroup /app/uploads /tmp/uploads
USER appuser

# Copy the built jar from the builder stage
COPY --from=builder /app/target/*.jar app.jar

EXPOSE 8080

CMD ["mvn", "spring-boot:run"]
ENV SERVER_PORT=8080

ENTRYPOINT ["java", "-jar", "app.jar"]
